# Copy this file to .env before running docker-compose up, and set your own
# MYSQL_ROOT_PASSWORD. Values are loaded at runtime via db/config.py (python-dotenv).

# MySQL
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=steam_katalog
MYSQL_PORT=3307

# MongoDB
MONGO_PORT=27017
MONGO_DB=Steams_Analytics
